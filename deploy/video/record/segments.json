{
  "_说明": [
    "录制脚本：每段的动作序列。record.mjs 逐段执行并录屏，录完拼成 raw/recording.mp4。",
    "动作种类：pane / removePane / term / app / exec / send / interrupt / clear / waitFor / wait",
    "改这里就能改录屏内容 —— 不用碰任何 JavaScript。"
  ],
  "segments": [
    {
      "id": "deploy",
      "title": "① 部署",
      "actions": [
        { "kind": "pane", "id": "server", "title": "服务终端 —— 后端与前端", "badge": "终端 A" },
        { "kind": "pane", "id": "ops", "title": "操作终端 —— 注入与查询", "badge": "终端 B" },
        { "kind": "wait", "seconds": 1.5 },

        { "kind": "exec", "id": "server", "cmd": "./deploy/start.sh --demo", "typingDelay": 0.035 },
        { "kind": "waitFor", "id": "server", "needle": "演示基线", "timeout": 60000 },
        { "kind": "wait", "seconds": 2.5 },
        { "kind": "waitFor", "id": "server", "needle": "Application startup complete", "timeout": 90000 },
        { "kind": "wait", "seconds": 12 }
      ]
    },

    {
      "id": "observe",
      "title": "② 正常观测",
      "actions": [
        { "kind": "term" },
        { "kind": "exec", "id": "ops", "cmd": "./deploy/inject_fault.sh healthy", "typingDelay": 0.03 },
        { "kind": "waitFor", "id": "ops", "needle": "正常负载", "timeout": 60000 },
        { "kind": "waitFor", "id": "ops", "needle": "当前诊断", "timeout": 60000 },
        { "kind": "wait", "seconds": 3 },

        { "kind": "app", "route": "/topology", "tab": "资源拓扑" },
        { "kind": "wait", "seconds": 30 }
      ]
    },

    {
      "id": "inject",
      "title": "③ 故障注入",
      "actions": [
        { "kind": "term" },
        { "kind": "exec", "id": "ops", "cmd": "./deploy/inject_fault.sh container_oom", "typingDelay": 0.03 },
        { "kind": "waitFor", "id": "ops", "needle": "跳过", "timeout": 90000 },
        { "kind": "waitFor", "id": "ops", "needle": "当前诊断", "timeout": 60000 },
        { "kind": "wait", "seconds": 3 },

        { "kind": "app", "route": "/alerts", "tab": "告警" },
        { "kind": "wait", "seconds": 42 }
      ]
    },

    {
      "id": "real",
      "title": "③b 真实证据",
      "actions": [
        { "kind": "term" },
        { "kind": "exec", "id": "ops", "cmd": "docker compose -f deploy/sample-workload/compose.yaml --profile starved up -d --force-recreate --no-build", "typingDelay": 0.012 },
        { "kind": "wait", "seconds": 20 },
        { "kind": "exec", "id": "ops", "cmd": "docker inspect demo-inference-starved --format 'OOMKilled={{.State.OOMKilled}} ExitCode={{.State.ExitCode}} Restarts={{.RestartCount}} MemLimit={{.HostConfig.Memory}}'", "typingDelay": 0.012 },
        { "kind": "wait", "seconds": 6 },
        { "kind": "exec", "id": "ops", "cmd": "python3 deploy/sample-workload/collect_real_events.py", "typingDelay": 0.02 },
        { "kind": "waitFor", "id": "ops", "needle": "已上报", "timeout": 90000 },
        { "kind": "wait", "seconds": 10 }
      ]
    },

    {
      "id": "crosslayer",
      "title": "④ 跨层关联",
      "actions": [
        { "kind": "term" },
        { "kind": "exec", "id": "ops", "cmd": "cd backend && ./.venv/bin/python -m app.demo demo --cross-layer", "typingDelay": 0.02 },
        { "kind": "waitFor", "id": "ops", "needle": "GPU_MEMORY_EXHAUSTED", "timeout": 120000 },
        { "kind": "wait", "seconds": 8 },
        { "kind": "exec", "id": "ops", "cmd": "cd ..", "typingDelay": 0.02 },
        { "kind": "wait", "seconds": 14 }
      ]
    },

    {
      "id": "diagnosis",
      "title": "⑤ 诊断输出",
      "actions": [
        { "kind": "app", "route": "/diagnoses", "tab": "诊断" },
        { "kind": "wait", "seconds": 26 },

        { "kind": "term" },
        { "kind": "exec", "id": "ops", "cmd": "python3 deploy/video/record/show_diagnosis.py", "typingDelay": 0.025 },
        { "kind": "wait", "seconds": 24 }
      ]
    }
  ]
}
