# ============================================================
# Crosslayer — repository ignore rules
#
# This file intentionally covers BOTH toolchains:
#
#   backend/    Python          (member B — see docs/TECH-BASELINE.md)
#   agents/     C / C++ / CMake (member A — language not yet decided)
#   frontend/   Node / npm      (member C)
#
# The C/C++ + CMake block above is KEPT, not legacy: member A's in-VM probe may
# be written in C or C++, and that decision is not yet made. Do not remove it.
# If member A confirms C will not be used, revisit this file with all members.
# ============================================================

# --- internal / non-product material (never shipped) ---
.project-internal/
*.docx
*.doc

# --- IDE ---
.idea/
.vscode/
*.iml
*.swp

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Node / npm (member C, frontend) ---
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-store/
next-env.d.ts
*.tsbuildinfo

# --- secrets & local config (never commit credentials) ---
.env
.env.*
!.env.example
*.pem
*.key
!id_*.pub

# --- local data / dumps ---
*.sqlite3
*.db
*.dump

# --- Windows / WSL metadata ---
*:Zone.Identifier
Thumbs.db
desktop.ini
