# Crosslayer 后端配置样例
# 复制为 .env 后填写真实值。.env 已被 .gitignore 排除，禁止提交。
# 配置项说明见 docs/DEPLOYMENT.md §4。

# --- 服务 ---
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=INFO
# 可选只读 Bearer Token，留空 = 关闭认证（默认关闭）
API_AUTH_TOKEN=

# --- 数据库 ---
DATABASE_URL=postgresql+psycopg://crosslayer:CHANGE_ME@localhost:5432/crosslayer

# --- ZSvirt 平台接入（测试环境信息由命题方私下提供，绝不写入仓库）---
ZSVIRT_ENDPOINT=
# 认证方式：oauth（直接给 token）| accesskey（用下面的 key/secret 登录换会话）
ZSVIRT_AUTH_STYLE=oauth
# 认证头为 Authorization: OAuth <token>
ZSVIRT_AUTH_TOKEN=
# accesskey 方式填这两项；会话约 2 小时过期，适配器会自动续期
ZSVIRT_ACCESS_KEY=
ZSVIRT_SECRET_KEY=
ZSVIRT_SYNC_INTERVAL_SEC=30

# --- ZWatch 指标渠道（见 backend/app/zsvirt/watch.py）---
# 测试环境控制台为自签证书；如需严格校验改为 true
ZSVIRT_VERIFY_TLS=false
ZSVIRT_TIMEOUT_SEC=8
# 指标查询窗口（分钟）与读数缓存（秒）
ZWATCH_WINDOW_MINUTES=15
ZWATCH_CACHE_TTL_SEC=10

# --- GPU 数据渠道（见 docs/DATA_MODEL.md §4.2.1）---
# zsvirt-zwatch | guest-smi | simulated | auto
GPU_PROVIDER=auto
# 无 GPU 环境的标准降级方式（赛题要求支持模拟/最小化降级模式）
SIMULATED_DATA_ENABLED=false

# --- 接入限制（成员 A 已确认）---
INGEST_BATCH_MAX=1000
INGEST_RESOURCE_MAX=500
INGEST_PAYLOAD_MAX_BYTES=1048576
CLOCK_DRIFT_WARN_MS=5000

# --- 诊断 ---
DIAG_WINDOW_TOLERANCE_SEC=30

# --- 敏感信息保护（见 docs/SENSITIVE_DATA.md）---
SENSITIVE_FILTER_ENABLED=true
